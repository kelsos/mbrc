<?xml version="1.0" encoding="UTF-8"?>
<!--
  Severity policy: a check we actually want enforced is an error, so CI fails on it.

  Lint only aborts the build on errors, so anything left at "warning" is invisible in CI and is
  only ever found by reading a report nobody reads. Leaving a check we care about at "warning" is
  the same as turning it off, but with more paperwork.

  Blanket warningsAsErrors is not an option: the dependency-freshness checks fire whenever a new
  version is published upstream, which would break CI on its own schedule with no code change.
  Those are ignored below because Renovate already opens the update PRs.

  Everything promoted here reports zero violations today, so a new error means new code.
-->
<lint>
  <issue id="InvalidPackage">
    <ignore regexp=".*okio.*" />
    <ignore regexp=".*velocity.*" />
    <ignore regexp=".*jacoco.*" />
    <ignore regexp="java.awt.*" />
    <ignore regexp="java.nio.file" />
  </issue>

  <!-- Correctness: each of these has a matching failure in this app's history. -->
  <!-- Cursors and TypedArrays that are never closed. -->
  <issue id="Recycle" severity="error" />
  <!-- Return values that must not be dropped. -->
  <issue id="CheckResult" severity="error" />
  <issue id="StringFormatCount" severity="error" />
  <issue id="StringFormatMatches" severity="error" />
  <issue id="SuspiciousIndentation" severity="error" />
  <issue id="StaticFieldLeak" severity="error" />
  <issue id="VisibleForTests" severity="error" />

  <!-- Service, notification and intent handling: the area behind #321, #344 and the widget
       trampoline crashes. -->
  <issue id="ForegroundServiceType" severity="error" />
  <issue id="NotificationPermission" severity="error" />
  <issue id="UnspecifiedRegisterReceiverFlag" severity="error" />
  <issue id="UnsafeIntentLaunch" severity="error" />
  <issue id="WakelockTimeout" severity="error" />
  <issue id="BatteryLife" severity="error" />

  <!-- Resources and API hygiene. -->
  <issue id="HardcodedText" severity="error" />
  <issue id="DuplicateStrings" severity="error">
    <!-- Languages without plural nouns translate "Album" and "Albums" the same way. -->
    <ignore path="**/values-*/strings.xml" />
  </issue>
  <issue id="UnusedResources" severity="error" />
  <issue id="ObsoleteSdkInt" severity="error" />
  <issue id="DiscouragedApi" severity="error" />
  <issue id="UseKtx" severity="error" />
  <issue id="SetTextI18n" severity="error" />
  <issue id="ClickableViewAccessibility" severity="error" />

  <!-- Translations. A string with no translation falls back to English at runtime, so a partial
       translation still works, and a new English string must not fail CI until a volunteer
       translates it. A translation that no longer has an English source, breaks a placeholder, or
       uses the wrong plural forms for its language is a real bug and stays an error.
       See TRANSLATING.md. -->
  <issue id="MissingTranslation" severity="ignore" />
  <issue id="ExtraTranslation" severity="error" />
  <issue id="StringFormatInvalid" severity="error" />
  <issue id="MissingQuantity" severity="error" />
  <issue id="UnusedQuantity" severity="error" />

  <!-- Kotlin interop. -->
  <issue id="ImplicitSamInstance" severity="error" />
  <issue id="KotlinPropertyAccess" severity="error" />
  <issue id="LambdaLast" severity="error" />
  <issue id="SyntheticAccessor" severity="error" />
  <issue id="WrongThreadInterprocedural" severity="error" />

  <!-- The Compose checks are promoted in the root build script instead: they are only registered
       where Compose is on the classpath, so naming them here would make every non-Compose module
       report UnknownIssueId. -->

  <!-- Owned by Renovate, and dependent on the outside world rather than on this repo. -->
  <issue id="GradleDependency" severity="ignore" />
  <issue id="NewerVersionAvailable" severity="ignore" />
  <issue id="AndroidGradlePluginVersion" severity="ignore" />

  <!-- Reports third-party jars we do not control. -->
  <issue id="InvalidPackage" severity="warning" />
  <!-- Promoting this would mean enabling resource shrinking on release builds, which changes the
       shipped artifact and wants testing of its own. -->
  <issue id="NotShrinkingResources" severity="warning" />
  <issue id="ObsoleteLintCustomCheck" severity="ignore" />
</lint>
